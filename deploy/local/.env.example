# Copy to deploy/local/.env — docker compose reads it automatically.
# Nothing here is a secret. Do not add real credentials to this file or to .env.

# --- agentgateway ----------------------------------------------------------
AGENTGATEWAY_VERSION=v1.5.0

# --- vLLM (dev / e2e model backend) ----------------------------------------
VLLM_IMAGE_TAG=latest-x86_64
# Must match llm.models[].params.model in gateway/config.yaml.
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# float32 is ~5x faster on prompt processing than bfloat16 on an AVX2-only CPU (study/01).
VLLM_DTYPE=float32
VLLM_MAX_MODEL_LEN=4096
VLLM_CPU_KVCACHE_SPACE=1
# Dummy key: vLLM ignores it, agentgateway's openAI provider requires one to be present.
VLLM_API_KEY=EMPTY
HF_CACHE_DIR=~/.cache/huggingface
VLLM_CACHE_DIR=~/.cache/vllm

# --- Bedrock (prod backend; declared, not exercised locally) ----------------
# Credentials come from the ambient AWS credential chain (IRSA in EKS), never from this file.
AWS_REGION=us-east-1
